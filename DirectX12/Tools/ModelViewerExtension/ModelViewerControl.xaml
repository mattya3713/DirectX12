<UserControl x:Class="ModelViewerExtension.ModelViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <ToolBar DockPanel.Dock="Top">
      <Button Click="OpenFileClick" Padding="12,4">Open .mskn / .mmat</Button>
      <TextBlock x:Name="FileNameText" Margin="12,0" VerticalAlignment="Center" Text="No file selected" />
    </ToolBar>
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="3*" />
        <ColumnDefinition Width="2*" MinWidth="300" />
      </Grid.ColumnDefinitions>
      <Viewport3D x:Name="Viewport" Grid.Column="0" ClipToBounds="True">
        <Viewport3D.Camera>
          <PerspectiveCamera Position="0,1.5,6" LookDirection="0,-0.5,-6" UpDirection="0,1,0" FieldOfView="45" />
        </Viewport3D.Camera>
        <ModelVisual3D>
          <ModelVisual3D.Content><AmbientLight Color="#606060" /></ModelVisual3D.Content>
        </ModelVisual3D>
        <ModelVisual3D x:Name="ModelVisual" />
      </Viewport3D>
      <ScrollViewer Grid.Column="1" Padding="12" VerticalScrollBarVisibility="Auto">
        <StackPanel>
          <TextBlock Text="Model" FontSize="18" FontWeight="Bold" />
          <TextBlock x:Name="SummaryText" Margin="0,8,0,16" TextWrapping="Wrap" />
          <TextBlock Text="Materials" FontSize="16" FontWeight="Bold" />
          <ItemsControl x:Name="MaterialsList" Margin="0,8,0,16" />
          <TextBlock Text="Validation" FontSize="16" FontWeight="Bold" />
          <TextBlock x:Name="StatusText" Margin="0,8" TextWrapping="Wrap" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </DockPanel>
</UserControl>
