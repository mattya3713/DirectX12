<UserControl x:Class="ModelViewerExtension.ModelViewerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#1E1E1E" Foreground="#F1F1F1"
             FontFamily="Segoe UI" FontSize="12">
  <UserControl.Resources>
    <SolidColorBrush x:Key="PanelBrush" Color="#252526" />
    <SolidColorBrush x:Key="CardBrush" Color="#2D2D30" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A7A7A7" />
    <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F1F1" /></Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style TargetType="Expander">
      <Setter Property="Foreground" Value="#F1F1F1" />
      <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
  </UserControl.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44" />
      <RowDefinition Height="*" />
      <RowDefinition Height="30" />
    </Grid.RowDefinitions>
    <Border Grid.Row="0" Background="#2D2D30" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid Margin="14,0">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="26" Height="26" CornerRadius="4" Background="#094771" VerticalAlignment="Center">
          <TextBlock Text="3D" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
          <TextBlock x:Name="FileNameText" Text="No file selected" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="FilePathText" Foreground="#A7A7A7" FontSize="10" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <Button Grid.Column="2" Click="OpenFileClick" Content="Open..." Padding="14,4" Margin="8,0,0,0" VerticalAlignment="Center" />
      </Grid>
    </Border>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="360" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="340" MinWidth="280" />
      </Grid.ColumnDefinitions>
      <Border x:Name="PreviewHost" Grid.Column="0" Background="#1B1B1C"
              MouseDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove"
              MouseUp="OnPreviewMouseUp" MouseWheel="OnPreviewMouseWheel">
        <Grid>
          <Viewport3D x:Name="Viewport" ClipToBounds="True" Margin="24">
            <Viewport3D.Camera>
              <PerspectiveCamera Position="0,1.5,6" LookDirection="0,-0.5,-6" UpDirection="0,1,0" FieldOfView="45" />
            </Viewport3D.Camera>
            <ModelVisual3D><ModelVisual3D.Content><AmbientLight Color="#A0A0A0" /></ModelVisual3D.Content></ModelVisual3D>
            <ModelVisual3D x:Name="ModelVisual" />
          </Viewport3D>
          <Border HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Padding="8,4" Background="#B0000000" CornerRadius="3">
            <TextBlock Text="LMB Orbit  ·  RMB Pan  ·  Wheel Zoom  ·  Double-click Frame"
                       Foreground="#A7A7A7" FontSize="10" FontWeight="SemiBold" />
          </Border>
        </Grid>
      </Border>
      <Border Grid.Column="1" Background="{StaticResource BorderBrush}" />
      <ScrollViewer Grid.Column="2" Background="{StaticResource PanelBrush}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16">
          <TextBlock Text="MODEL INFO" Style="{StaticResource SectionTitle}" />
          <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,18">
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap" LineHeight="19" />
          </Border>
          <TextBlock Text="MATERIALS" Style="{StaticResource SectionTitle}" />
          <ItemsControl x:Name="MaterialsList" Margin="0,0,0,12" />
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Background="#007ACC" Padding="12,0">
      <Grid>
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
        <TextBlock Text="Runtime Model Viewer" HorizontalAlignment="Right" VerticalAlignment="Center" Opacity="0.8" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
