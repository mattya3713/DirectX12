<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Treat all .hlsl files as content and copy them to the output directory so runtime
       compilation (D3DCompileFromFile) can load them directly. Also remove any FxCompile
       entries so Visual Studio doesn't try to compile HLSL files at build time. -->
  <ItemGroup>
    <!-- Remove any existing FxCompile items that include HLSL files -->
    <FxCompile Remove="**\*.hlsl" />

    <!-- Include HLSL files as Content and copy to output directory when newer.
         Scoped to SourceCode\ and Data\Shader\ only (NOT a bare **\*.hlsl over the whole
         project root): the output directories (x64\Debug\, x64\Release\) live under the
         project root too, so an unscoped glob re-matches files this same step already
         copied there on a previous build and copies them again one level deeper, causing
         the output tree to nest and multiply on every single build (found 239k+ files,
         17+ levels of x64\Debug\x64\Release\... nesting, after repeated builds). Also
         excludes vendored third-party .hlsl files under Data\Library\ (e.g. DirectXTex's
         own shaders), which this project never loads. -->
    <Content Include="SourceCode\**\*.hlsl;Data\Shader\**\*.hlsl">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
